{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.ts": {
      "runtime": "@vercel/node@3.2.26",
      "includeFiles": "{data,knowledge,config}/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.orionchocolatesfinos.com.br" }],
      "destination": "https://orionchocolatesfinos.com.br/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(llms.txt|llms-full.txt|robots.txt|.well-known/ai.txt)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/spa-fallback" }
  ]
}
